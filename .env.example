# RegCheck environment configuration
# Copy this file to backend/.env and fill in your keys.
# Never commit the real .env file — it is gitignored.

# --- LLM provider keys (both free) --------------------------------------
# Groq: free API, used for fast/cheap calls (extraction drafts).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: used for stronger-model calls. The default model below has the
# ":free" suffix, which routes to OpenRouter's zero-cost model pool — no
# payment method required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Provider routing ----------------------------------------------------
# "auto" (default): fast tier -> Groq, strong tier -> OpenRouter.
# Set to "groq" or "openrouter" to force everything through one provider.
LLM_PROVIDER_MODE=auto

# Model overrides (optional — sensible defaults are set in app/config.py).
# Both defaults below are free-tier models.
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
